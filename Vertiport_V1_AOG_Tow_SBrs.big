# V1: one aircraft becomes AOG during a pre-departure motor test on the FATO.
# Export: -c n_evtol=6,incident_rate=1,tow_rate=0.06666666666666667
# The analysis conditions the fault-free stationary distribution on PadOut,
# then applies aog at t=0. The trigger rate only exports the event mapping;
# it is not an estimated AOG frequency. No second incident can occur.
# Towed records off-site removal and immediate replacement by a spare aircraft.
# It is an audit marker, not a member of the circulating population.
# Conservation: AppN + TiN + ToN + #Svc + #Rdy + #occupied FATO = N.

ctrl FATO = 0;
atomic ctrl Free = 0;
atomic ctrl PadIn = 0;
atomic ctrl PadOut = 0;
atomic ctrl Blocked = 0;
atomic ctrl Towed = 0;
ctrl Incident = 0;
atomic ctrl Armed = 0;
atomic ctrl Spent = 0;
ctrl Approach = 0; atomic fun ctrl AppN(k) = 0;
ctrl TaxiIn = 0; atomic fun ctrl TiN(k) = 0;
ctrl TaxiOut = 0; atomic fun ctrl ToN(k) = 0;
ctrl Stands = 0;
ctrl Stand = 0;
atomic ctrl Empty = 0;
atomic ctrl Svc = 0;
atomic ctrl Rdy = 0;

float rate_land = 1.0;
float rate_clear = 2.0;
float rate_enter = 1.3333333333;
float rate_service = 0.1;
float rate_leave = 4.0;
float rate_lineup = 1.5;
float rate_takeoff = 1.0;
int rew_takeoff = 1;

fun react land(a) = Approach.AppN(a) | FATO.Free
  -[rate_land]-> Approach.AppN(a - 1) | FATO.PadIn;
fun react clear_pad(t) = FATO.PadIn | TaxiIn.TiN(t)
  -[rate_clear]-> FATO.Free | TaxiIn.TiN(t + 1);
fun react enter_stand(t) = TaxiIn.TiN(t) | Stands.(Stand.Empty | id)
  -[rate_enter]-> TaxiIn.TiN(t - 1) | Stands.(Stand.Svc | id);
react turnaround = Stands.(Stand.Svc | id)
  -[rate_service]-> Stands.(Stand.Rdy | id);
fun react leave_stand(o) = Stands.(Stand.Rdy | id) | TaxiOut.ToN(o)
  -[rate_leave]-> Stands.(Stand.Empty | id) | TaxiOut.ToN(o + 1);
fun react lineup(o) = TaxiOut.ToN(o) | FATO.Free
  -[rate_lineup]-> TaxiOut.ToN(o - 1) | FATO.PadOut;
fun react takeoff(a) = FATO.PadOut | Approach.AppN(a)
  -[rate_takeoff]-> FATO.Free | Approach.AppN(a + 1);

# Blocked retains the disabled aircraft and cannot use nominal clear/takeoff.
react aog = FATO.PadOut | Incident.Armed
  -[incident_rate]-> FATO.Blocked | Incident.Spent;
# One tow removes the AOG aircraft to an external maintenance area and admits
# a spare into Approach, maintaining N circulating aircraft without assuming
# that the disabled aircraft has been repaired.
# There is no extra nominal 30-second clear stage after this 15-minute mean.
fun react tow(a) = FATO.Blocked | Approach.AppN(a)
  -[tow_rate]-> FATO.Free | Approach.AppN(a + 1) | Towed;

big takeoff_enabled = FATO.PadOut;
big armed = Incident.Armed;
big spent = Incident.Spent;
big blocked = FATO.Blocked;
big towed = Towed;
big pad_in = FATO.PadIn;
big pad_out = FATO.PadOut;
fun big app_at(a) = Approach.AppN(a);
fun big taxi_in_at(t) = TaxiIn.TiN(t);
fun big taxi_out_at(o) = TaxiOut.ToN(o);
big svc_ge_1 = Stands.(Stand.Svc | id);
big svc_ge_2 = Stands.(Stand.Svc | Stand.Svc | id);
big svc_ge_3 = Stands.(Stand.Svc | Stand.Svc | Stand.Svc | id);
big rdy_ge_1 = Stands.(Stand.Rdy | id);
big rdy_ge_2 = Stands.(Stand.Rdy | Stand.Rdy | id);
big rdy_ge_3 = Stands.(Stand.Rdy | Stand.Rdy | Stand.Rdy | id);

# The warm-start distribution is computed by the analysis, not this cold seed.
big s0 = Approach.AppN(n_evtol) | FATO.Free | TaxiIn.TiN(0)
  | TaxiOut.ToN(0) | Stands.(Stand.Empty | Stand.Empty | Stand.Empty)
  | Incident.Armed;

begin sbrs
  int pos = [1:1:n_evtol];
  int below = [0:1:n_evtol - 1];
  int counts = [0:1:n_evtol];
  init s0;
  rules = [{land(pos), clear_pad(below), enter_stand(pos), turnaround,
            leave_stand(below), lineup(pos), takeoff(below), aog, tow(below)}];
  preds = {takeoff_enabled[rew_takeoff], armed, spent, blocked, towed,
           pad_in, pad_out, app_at(counts), taxi_in_at(counts),
           taxi_out_at(counts), svc_ge_1, svc_ge_2, svc_ge_3,
           rdy_ge_1, rdy_ge_2, rdy_ge_3};
end
