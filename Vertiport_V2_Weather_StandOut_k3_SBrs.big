# =====================================================================
# eVTOL Vertiport - V2 compound capacity: 3 stands out of service + weather
# ---------------------------------------------------------------------
# V2 layout (1 FATO + 4 stands).  Sustained capacity when THREE stands are
# permanently out of service while weather fluctuates Good <-> Bad with
# rate-degradation (land/lineup/turnaround slowed in bad weather).  The
# out-of-service stands never repair (inert Stand.Out).  Only ONE stand
# remains, so V2 keeps positive capacity here whereas V1 (3 stands)
# reaches full blockage.  Steady-state R=?[S] gives the V2 capacity
# heat-map row for stands_out=3 (fig6, V2).
#
# Command line:  -c n_evtol=6,weather_fault_rate=0.05,weather_repair_rate=0.05
# =====================================================================

ctrl FATO       = 0;
atomic ctrl Free   = 0;
atomic ctrl PadIn  = 0;
atomic ctrl PadOut = 0;

ctrl Approach   = 0;  atomic fun ctrl AppN(k) = 0;
ctrl TaxiIn     = 0;  atomic fun ctrl TiN(k)  = 0;
ctrl TaxiOut    = 0;  atomic fun ctrl ToN(k)  = 0;
ctrl Stands     = 0;
ctrl Stand      = 0;
atomic ctrl Empty = 0;
atomic ctrl Out   = 0;
atomic ctrl Svc   = 0;
atomic ctrl Rdy   = 0;

ctrl Weather = 0;
atomic ctrl Good = 0;
atomic ctrl Bad  = 0;

int m_stand = 4;

float rate_land     = 1.0;
float rate_clear    = 2.0;
float rate_enter    = 1.3333333333;
float rate_service  = 0.1;
float rate_leave    = 4.0;
float rate_lineup   = 1.5;
float rate_takeoff  = 1.0;

float wx_land    = 0.3;
float wx_lineup  = 0.3;
float wx_service = 0.5;

int rew_takeoff = 1;

fun react land_good(a) =
    Approach.AppN(a) | FATO.Free | Weather.Good
  -[rate_land]->
    Approach.AppN(a - 1) | FATO.PadIn | Weather.Good;

fun react land_bad(a) =
    Approach.AppN(a) | FATO.Free | Weather.Bad
  -[rate_land * wx_land]->
    Approach.AppN(a - 1) | FATO.PadIn | Weather.Bad;

fun react clear_pad(t) =
    FATO.PadIn | TaxiIn.TiN(t)
  -[rate_clear]->
    FATO.Free | TaxiIn.TiN(t + 1);

fun react enter_stand(t) =
    TaxiIn.TiN(t) | Stands.(Stand.Empty | id)
  -[rate_enter]->
    TaxiIn.TiN(t - 1) | Stands.(Stand.Svc | id);

react turnaround_good =
    Stands.(Stand.Svc | id) | Weather.Good
  -[rate_service]->
    Stands.(Stand.Rdy | id) | Weather.Good;

react turnaround_bad =
    Stands.(Stand.Svc | id) | Weather.Bad
  -[rate_service * wx_service]->
    Stands.(Stand.Rdy | id) | Weather.Bad;

fun react leave_stand(o) =
    Stands.(Stand.Rdy | id) | TaxiOut.ToN(o)
  -[rate_leave]->
    Stands.(Stand.Empty | id) | TaxiOut.ToN(o + 1);

fun react lineup_good(o) =
    TaxiOut.ToN(o) | FATO.Free | Weather.Good
  -[rate_lineup]->
    TaxiOut.ToN(o - 1) | FATO.PadOut | Weather.Good;

fun react lineup_bad(o) =
    TaxiOut.ToN(o) | FATO.Free | Weather.Bad
  -[rate_lineup * wx_lineup]->
    TaxiOut.ToN(o - 1) | FATO.PadOut | Weather.Bad;

fun react takeoff(a) =
    FATO.PadOut | Approach.AppN(a)
  -[rate_takeoff]->
    FATO.Free | Approach.AppN(a + 1);

react weather_fault =
    Weather.Good -[weather_fault_rate]-> Weather.Bad;

react weather_repair =
    Weather.Bad -[weather_repair_rate]-> Weather.Good;

big takeoff_enabled = FATO.PadOut;
big weather_bad     = Weather.Bad;
big pad_landing     = FATO.PadIn;
big pad_departing   = FATO.PadOut;
big some_stand_free = Stands.(Stand.Empty | id);

big s0 =
    Approach.AppN(n_evtol)
  | FATO.Free
  | TaxiIn.TiN(0)
  | TaxiOut.ToN(0)
  | Stands.(Stand.Out | Stand.Out | Stand.Out | Stand.Empty)
  | Weather.Good;

begin sbrs
  int a_pos   = [1:1:n_evtol];   int a_any0 = [0:1:n_evtol - 1];
  int t_pos   = [1:1:n_evtol];   int t_any0 = [0:1:n_evtol - 1];
  int o_pos   = [1:1:n_evtol];   int o_any0 = [0:1:n_evtol - 1];
  init s0;
  rules = [
    { land_good(a_pos), land_bad(a_pos),
      takeoff(a_any0), clear_pad(t_any0),
      enter_stand(t_pos), turnaround_good, turnaround_bad,
      leave_stand(o_any0), lineup_good(o_pos), lineup_bad(o_pos),
      weather_fault, weather_repair }
  ];
  preds = {
    takeoff_enabled[rew_takeoff],
    weather_bad,
    pad_landing,
    pad_departing,
    some_stand_free
  };
end
