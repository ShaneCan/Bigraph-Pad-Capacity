// Usage:
//   # 1. Generate CTMC (replace N with fleet size, e.g. 3/4; n=5 may be slow)
//   bigrapher full --solver=MCARD -c n_drones=N -M 200000 -q \
//     -p _prism_tmp/4stand_nN.tra \
//     -l _prism_tmp/4stand_nN.csl \
//     -r _prism_tmp/4stand_nN.rews \
//     vertiport_susmoy_4stand.big
//
//   # 2. Combine label definitions with these queries
//   cat _prism_tmp/4stand_nN.csl queries_4stand.props > _prism_tmp/4stand_nN.combined.csl
//
//   # 3. Run PRISM steady-state analysis
//   prism -javastack 64m \
//     -importtrans   _prism_tmp/4stand_nN.tra \
//     -importstaterewards _prism_tmp/4stand_nN.rews \
//     -ctmc _prism_tmp/4stand_nN.combined.csl \
//     -gs -maxiters 500000
//
// Result interpretation:
//   R=? [S]       → steady-state reward rate; multiply by 60 → OPH (flights/hour)
//   S=? ["X"]     → steady-state probability of being in states satisfying label X
//   Stand util    → stand_svc_s + stand_rdy_s  (unserviced + ready-to-depart)
//   Taxi occupancy time per segment  →  p_busy / arrival_rate  (Little's law;
//                                     arrival_rate = OPH / 60 flights/min)
//                                     plot: mean over all segments

// --- Throughput ---
R=? [ S ]

// --- Pad state ---
S=? [ "pad_free" ]
S=? [ "pad_in" ]
S=? [ "pad_out" ]

// --- Taxi-segment occupancy ---
// Taxi(0) = S2 (taxi-in from FATO)
S=? [ "taxi_busy_0" ]
// Taxi(1) = Apron-A
S=? [ "taxi_busy_1" ]
// Taxi(2) = Apron-B
S=? [ "taxi_busy_2" ]
// Taxi(3) = Apron-C
S=? [ "taxi_busy_3" ]
// Taxi(4) = S1 (taxi-out to FATO)
S=? [ "taxi_busy_4" ]

// --- Blocking at last apron (unserviced drone queued for Stand(3)) ---
S=? [ "wait_last_stand" ]
