# =====================================================================
#   Approach --land--> Pad (FATO)
#     --clear--> Taxi(0)=S2 (taxi-in)
#       --taxi--> Taxi(1)=Apron-A --taxi--> Taxi(2)=Apron-B
#         --taxi_out_seg (SERVICED only)--> Taxi(3)=S1 (taxi-out)
#           --lineup--> Pad --takeoff--> Approach   (closed saturated loop)
# Fixes:
#   (i)  Sidings enter/exit on different segments → no 2-cycle contention.
#   (ii) Unserviced aircraft may NOT advance to Taxi(3) (taxi_out_seg
#        requires Drone.Serviced) → must pull into Stand(2).
#   (iii) Number of taxiway is fixed.
# Supply fleet size via CLI:  bigrapher full -c n_drones=4 ...
# =====================================================================

ctrl Pad   = 0;
ctrl Drone = 0;
fun ctrl Taxi(n)   = 0;         # segment n: 0=S2(in), 1,2=apron, 3=S1(out)
fun ctrl Stands(k) = 0;         # stand k (0,1,2), siding off Taxi(k)
atomic ctrl Serviced = 0;
atomic ctrl Free     = 0;
ctrl Occ = 0;
atomic fun ctrl Approach(k) = 0;

int max_taxi   = 4;             # segments: Taxi(0)..Taxi(3)
int max_stands = 3;             # stands:   Stands(0)..Stands(2)

float rate_land    = 1.0;       # touch-down                        (60 s)
float rate_clear   = 2.0;       # vacate pad → Taxi(0)              (30 s)
float rate_taxi    = 4.0;       # one-way segment hop               (15 s)
float rate_enter   = 1.3333333333; # pull into stand                (45 s)
float rate_service = 0.1;       # turnaround                        (10 min)
float rate_leave   = 4.0;       # push back from stand              (15 s)
float rate_lineup  = 1.5;       # line up on pad for departure      (40 s)
float rate_takeoff = 1.0;       # lift-off                          (60 s)

int rew_takeoff = 1;            # throughput reward (must = rate_takeoff)

# =====================================================================
# Reaction rules
# =====================================================================

fun react land(a) =
    Approach(a) | Pad.Free
  -[rate_land]->
    Approach(a - 1) | Pad.Occ.Drone.1;

react clear_pad =
    Pad.Occ.Drone.1 | Taxi(0).Free
  -[rate_clear]->
    Pad.Free | Taxi(0).Occ.Drone.1;

fun react taxi(t) =
    Taxi(t - 1).Occ.id | Taxi(t).Free
  -[rate_taxi]->
    Taxi(t - 1).Free | Taxi(t).Occ.id;

# Serviced-only gate: an unserviced aircraft on Taxi(2) must park in Stand(2).
react taxi_out_seg =
    Taxi(max_taxi - 2).Occ.Drone.Serviced | Taxi(max_taxi - 1).Free
  -[rate_taxi]->
    Taxi(max_taxi - 2).Free | Taxi(max_taxi - 1).Occ.Drone.Serviced;

fun react take_stand(t) =
    Taxi(t).Occ.Drone.1 | Stands(t).Free
  -[rate_enter]->
    Taxi(t).Free | Stands(t).Occ.Drone.1;

fun react serve(s) =
    Stands(s).Occ.Drone.1
  -[rate_service]->
    Stands(s).Occ.Drone.Serviced;

fun react leave_stand(t) =
    Stands(t).Occ.Drone.Serviced | Taxi(t + 1).Free
  -[rate_leave]->
    Stands(t).Free | Taxi(t + 1).Occ.Drone.Serviced;

react lineup =
    Taxi(max_taxi - 1).Occ.Drone.Serviced | Pad.Free
  -[rate_lineup]->
    Taxi(max_taxi - 1).Free | Pad.Occ.Drone.Serviced;

fun react takeoff(a) =
    Pad.Occ.Drone.Serviced | Approach(a)
  -[rate_takeoff]->
    Pad.Free | Approach(a + 1);

# =====================================================================
# Predicates
# =====================================================================

big takeoff_enabled = Pad.Occ.Drone.Serviced;

big pad_free = Pad.Free;
big pad_in   = Pad.Occ.Drone.1;
big pad_out  = Pad.Occ.Drone.Serviced;

fun big stand_free(s) = Stands(s).Free;
fun big stand_svc(s)  = Stands(s).Occ.Drone.1;
fun big stand_rdy(s)  = Stands(s).Occ.Drone.Serviced;

fun big taxi_busy(t)  = Taxi(t).Occ.id;

# Unserviced drone blocked on last apron segment waiting for Stand(2).
big wait_last_stand = Taxi(max_taxi - 2).Occ.Drone.1;

# =====================================================================
# Initial state
# =====================================================================

big s0 =
    Approach(n_drones)
  | Pad.Free
  | Taxi(0).Free | Taxi(1).Free | Taxi(2).Free | Taxi(3).Free
  | Stands(0).Free | Stands(1).Free | Stands(2).Free;

begin sbrs
  int a_land = [1:1:n_drones];
  int a_toff = [0:1:n_drones - 1];
  int t_seg  = [1:1:max_taxi - 2];       # apron moves: taxi(1), taxi(2)
  int t_all  = [0:1:max_taxi - 1];       # all segments: 0..3
  int s_idx  = [0:1:max_stands - 1];     # all stands:   0..2
  init s0;
  rules = [
    { land(a_land),
      clear_pad,
      taxi(t_seg),
      taxi_out_seg,
      take_stand(s_idx),
      serve(s_idx),
      leave_stand(s_idx),
      lineup,
      takeoff(a_toff) }
  ];
  preds = {
    takeoff_enabled[rew_takeoff],
    pad_free, pad_in, pad_out,
    stand_svc(s_idx), stand_rdy(s_idx), stand_free(s_idx),
    taxi_busy(t_all),
    wait_last_stand
  };
end
