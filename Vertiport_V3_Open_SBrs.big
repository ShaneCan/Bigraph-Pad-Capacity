# =====================================================================
# eVTOL Vertiport - Structure V3 Open Arrival : 2 FATO + 4 Stands
# ---------------------------------------------------------------------
# Open M/M/c/K-style CTMC variant of V3.  Aircraft arrive from outside
# with a Poisson rate arr_rate into a finite approach queue (capacity
# k_app).  If the approach queue is full, no arrival transition is
# enabled; by PASTA, S=?["approach_full"] is the blocking / loss
# probability.
#
# Departures leave the system instead of recycling to the approach.
# Throughput (flights/hour): each take-off = one flight; = 60 * R=?[S].
#
# This is the TAXI-ABSTRACT open model, matched in abstraction to the
# V1 / V2 open models (shared TaxiIn / TaxiOut counters), so the open
# lambda-sweep in fig2 compares V1 / V2 / V3 at the same modelling level.
# V3 = two independent FATO pads + 4 stands.  (The explicit bidirectional
# U-taxiway is used for the saturated capacity study fig1/fig3; its open
# form is state-space intractable, and the taxiway conflict detail does
# not affect the M/M/c/K queueing metrics plotted here.)
#
# Command line:
#   -c arr_rate=0.5,k_app=20,k_taxi=3
# =====================================================================

# ---------- pads (two independent unified FATO pads) ------------------
ctrl FATO1 = 0;
ctrl FATO2 = 0;
atomic ctrl Free   = 0;
atomic ctrl PadIn  = 0;
atomic ctrl PadOut = 0;

# ---------- approach queue (open arrivals, finite buffer) -------------
ctrl Approach = 0; atomic fun ctrl AppN(k) = 0;

# ---------- abstract taxi counters (shared, as in V1/V2) --------------
ctrl TaxiIn   = 0; atomic fun ctrl TiN(k) = 0;
ctrl TaxiOut  = 0; atomic fun ctrl ToN(k) = 0;

# ---------- stands ----------------------------------------------------
ctrl Stands = 0;
ctrl Stand  = 0;
atomic ctrl Empty = 0;
atomic ctrl Svc   = 0;
atomic ctrl Rdy   = 0;

int m_stand = 4;

# ---------- rates (per minute) ----------------------------------------
float rate_land    = 1.0;
float rate_clear   = 2.0;
float rate_enter   = 1.3333333333;
float rate_service = 0.1;
float rate_leave   = 4.0;     # push back (15 s)
float rate_lineup  = 1.5;     # taxi to pad (40 s)
float rate_takeoff = 1.0;

int rew_takeoff = 1;

# =====================================================================
# Open arrival: a new aircraft joins the approach queue (finite buffer).
# =====================================================================
fun react arrival(a) =
    Approach.AppN(a) -[arr_rate]-> Approach.AppN(a + 1);

# =====================================================================
# Landing on either pad.
# =====================================================================
fun react land1(a, t) =
    Approach.AppN(a) | FATO1.Free | TaxiIn.TiN(t)
  -[rate_land]->
    Approach.AppN(a - 1) | FATO1.PadIn | TaxiIn.TiN(t);

fun react land2(a, t) =
    Approach.AppN(a) | FATO2.Free | TaxiIn.TiN(t)
  -[rate_land]->
    Approach.AppN(a - 1) | FATO2.PadIn | TaxiIn.TiN(t);

# =====================================================================
# Vacate a pad onto the inbound taxi counter.
# =====================================================================
fun react clear_pad1(t) =
    FATO1.PadIn | TaxiIn.TiN(t) -[rate_clear]-> FATO1.Free | TaxiIn.TiN(t + 1);
fun react clear_pad2(t) =
    FATO2.PadIn | TaxiIn.TiN(t) -[rate_clear]-> FATO2.Free | TaxiIn.TiN(t + 1);

# =====================================================================
# Park into a free stand; turnaround; push back onto the outbound taxi.
# =====================================================================
fun react enter_stand(t) =
    TaxiIn.TiN(t) | Stands.(Stand.Empty | id)
  -[rate_enter]->
    TaxiIn.TiN(t - 1) | Stands.(Stand.Svc | id);

react turnaround =
    Stands.(Stand.Svc | id) -[rate_service]-> Stands.(Stand.Rdy | id);

fun react leave_stand(o) =
    Stands.(Stand.Rdy | id) | TaxiOut.ToN(o)
  -[rate_leave]->
    Stands.(Stand.Empty | id) | TaxiOut.ToN(o + 1);

# =====================================================================
# Line up on either free pad, then take off (departures leave the system).
# =====================================================================
fun react lineup1(o) =
    TaxiOut.ToN(o) | FATO1.Free -[rate_lineup]-> TaxiOut.ToN(o - 1) | FATO1.PadOut;
fun react lineup2(o) =
    TaxiOut.ToN(o) | FATO2.Free -[rate_lineup]-> TaxiOut.ToN(o - 1) | FATO2.PadOut;

react takeoff1 = FATO1.PadOut -[rate_takeoff]-> FATO1.Free;
react takeoff2 = FATO2.PadOut -[rate_takeoff]-> FATO2.Free;

# =====================================================================
# Predicates: throughput reward, blocking, interior occupancy, safety.
# =====================================================================
big takeoff1_enabled     = FATO1.PadOut;
big takeoff2_enabled     = FATO2.PadOut;
big pad1_free            = FATO1.Free;
big pad2_free            = FATO2.Free;
big some_stand_free      = Stands.(Stand.Empty | id);
big approach_full        = Approach.AppN(k_app);
fun big taxi_in_count(t) = TaxiIn.TiN(t);
fun big taxi_out_count(o)= TaxiOut.ToN(o);
big svc_at_least_1       = Stands.(Stand.Svc | id);
big svc_at_least_2       = Stands.(Stand.Svc | Stand.Svc | id);
big svc_at_least_3       = Stands.(Stand.Svc | Stand.Svc | Stand.Svc | id);
big svc_at_least_4       = Stands.(Stand.Svc | Stand.Svc | Stand.Svc | Stand.Svc | id);
big rdy_at_least_1       = Stands.(Stand.Rdy | id);
big rdy_at_least_2       = Stands.(Stand.Rdy | Stand.Rdy | id);
big rdy_at_least_3       = Stands.(Stand.Rdy | Stand.Rdy | Stand.Rdy | id);
big rdy_at_least_4       = Stands.(Stand.Rdy | Stand.Rdy | Stand.Rdy | Stand.Rdy | id);
# Per-pad occupancy (each 0/1): E[# pads busy] = sum of the four probs.
big pad1_landing         = FATO1.PadIn;
big pad1_departing       = FATO1.PadOut;
big pad2_landing         = FATO2.PadIn;
big pad2_departing       = FATO2.PadOut;

big s0 =
    Approach.AppN(0)
  | FATO1.Free | FATO2.Free
  | TaxiIn.TiN(0)
  | TaxiOut.ToN(0)
  | Stands.(Stand.Empty | Stand.Empty | Stand.Empty | Stand.Empty);

begin sbrs
  int app_arr = [0:1:k_app - 1];
  int app_pos = [1:1:k_app];
  int ti_pos  = [1:1:k_taxi];
  int ti_any0 = [0:1:k_taxi - 1];
  int to_pos  = [1:1:k_taxi];
  int to_any0 = [0:1:k_taxi - 1];
  int taxi_all = [0:1:k_taxi];
  init s0;
  rules = [
    { arrival(app_arr),
      land1(app_pos, ti_any0), land2(app_pos, ti_any0),
      clear_pad1(ti_any0), clear_pad2(ti_any0),
      enter_stand(ti_pos), turnaround, leave_stand(to_any0),
      lineup1(to_pos), lineup2(to_pos), takeoff1, takeoff2 }
  ];
  preds = {
    takeoff1_enabled[rew_takeoff],
    takeoff2_enabled[rew_takeoff],
    pad1_free,
    pad2_free,
    some_stand_free,
    approach_full,
    taxi_in_count(taxi_all),
    taxi_out_count(taxi_all),
    svc_at_least_1,
    svc_at_least_2,
    svc_at_least_3,
    svc_at_least_4,
    rdy_at_least_1,
    rdy_at_least_2,
    rdy_at_least_3,
    rdy_at_least_4,
    pad1_landing,
    pad1_departing,
    pad2_landing,
    pad2_departing
  };
end
